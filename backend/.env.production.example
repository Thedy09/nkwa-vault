# Configuration de production pour Nkwa Vault
# Copiez ce fichier vers .env et configurez les valeurs

NODE_ENV=production
PORT=4000

# Base de données PostgreSQL (obligatoire)
DATABASE_URL=postgresql://username:password@host:5432/nkwa_vault?schema=public

# Sécurité (obligatoire — générer avec: openssl rand -hex 32)
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
AUTH_DEMO_MODE=false

# CORS et URLs
FRONTEND_URL=https://nkwa-vault.vercel.app
CORS_ORIGIN=https://nkwa-vault.vercel.app,https://nkwa.africa
# ALLOW_VERCEL_PREVIEWS=true

# Redis (optionnel)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Blockchain EVM (Vyper Registry)
EVM_RPC_URL=https://sepolia.base.org
EVM_CHAIN_ID=84532
EVM_NETWORK=base-sepolia
EVM_EXPLORER_URL=https://sepolia.basescan.org
EVM_RELAYER_PRIVATE_KEY=0x...
EVM_REGISTRY_CONTRACT=0xYourCulturalRegistryAddress
DEFAULT_REWARD_ADDRESS=0x0000000000000000000000000000000000000000

# IPFS (au moins une option)
# IPFS_API_URL=https://ipfs.my-provider.example
# IPFS_API_TOKEN=...
# IPFS_PROJECT_ID=...
# IPFS_PROJECT_SECRET=...

# Cloudinary (optionnel, pour les médias)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Logs et monitoring
LOG_LEVEL=info
# ENABLE_SWAGGER=false

# Admin initial (utilisé par prisma db seed)
ADMIN_EMAIL=admin@nkwa.africa
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Administrateur Nkwa
